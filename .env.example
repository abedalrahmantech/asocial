# Convex
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CLERK_WEBHOOK_SIGNING_SECRET=

# Vercel AI Gateway (OIDC — preferred on Vercel)
# Run: vercel link && vercel env pull .env.local
# This provisions VERCEL_OIDC_TOKEN locally; no AI_GATEWAY_API_KEY needed on Vercel.
VERCEL_OIDC_TOKEN=

# Optional model override (provider/model format)
AI_MODEL=openai/gpt-5.5

# Convex server-side AI (Convex actions run outside Vercel)
# Set on Convex: npx convex env set AI_GATEWAY_API_KEY <key>
# Get a key from Vercel Dashboard → Project → AI Gateway, or use OIDC only on Vercel routes.
AI_GATEWAY_API_KEY=
